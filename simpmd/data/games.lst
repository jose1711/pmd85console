TANKY;2;ROM basic2.rmm, FONT, TYPE LOAD 53, TYPE RUN;E=F2,Z=F1,Up=F2,Down=F1,Return=F4,Space=F4;Down:F1,Up:F2,Fire:F4,Esc:Escape;F1 dolu, F2 nahoru, F4 palba (K0, K1, K3), pak libovolna klavesa;PR;2 hraci
TAVA;2;ROM basic2.rmm, FONT, TYPE LOAD 5, TYPE RUN;;;text hra: F1 ano, F2 ne (instrukce), prikazy z klavesnice;;Textove adventury
TENISS;2;MGLD 00, JUMP 7000;;1:1,2:2,3:3,P1 Q:q,P1 A:a,P1 Z:z,P1 X:x,P2 /:/,P2 .:.,P2 End:End,P2 5:Keypad 5,Esc:Escape;nejdriv 1/2/3, hrac1 Q A Z X, hrac2 / . End Num5;;2 hraci
TETRIS;2;MGLD 03;;;;;
VIDEOSTP;2;ROM basic2.rmm, FONT, TYPE LOAD 11, TYPE RUN;;;F1 (K0) zastavi kostky, Enter, jmeno z klavesnice;;
VOTRELCI;2;ROM basic2.rmm, FONT, TYPE LOAD 0, TYPE RUN;E=F1,Z=F2,Up=F1,Down=F2,Left Shift=F9;Up:F1,Down:F2,Fire:F9,Space:Space,Esc:Escape;F1 zbran nahoru, F2 dolu, F9 vystrel, mezernik start, pri konci 1 nebo 0 (pad: D-pad, LB vystrel, A start);;
WILLY;1;MGLD 00;;;;;WILLY
WURMI;2;ROM basic2.rmm, FONT, TYPE LOAD 7, TYPE RUN;Left=F1,Right=F4,Up=F3,Down=F2,E=F3,Z=F2;Left:F1,Down:F2,Up:F3,Right:F4,Esc:Escape;F1 vlevo, F2 dole, F3 nahoru, F4 vpravo (K0-K3), pak libovolna klavesa;PR;
ZABY;1;MGLD 00, JUMP 1500;;Jump:F5,Start line:F10,Esc:Escape;F5 = skok, F10 = startovaci cara, zapis jmena do tabulky z klavesnice;;
ZED;1;MGLD 00, JUMP 1000;Left=Left Shift,Right=V;Left:Left,Right:Right,Shift:Left Shift,Esc:Escape;Shift = vlevo, V = vpravo;PR;
ZMRZLINY;2;MGLD 00;;;;;Pro nejmensi
ZOFKA2;2;ROM basic2.rmm, FONT, TYPE LOAD 10, TYPE RUN;;;korytnacka Zofka (Logo): prikazy z klavesnice, potvrzeni Enter;;Programovani/ZOFKA
ZOFKA2-STARA;2;ROM basic2.rmm, FONT, TYPE LOAD 12, TYPE RUN;;;starsi verze Zofky: prikazy z klavesnice, potvrzeni Enter;;Programovani/ZOFKA
ZOFKA2T;2;ROM basic2.rmm, FONT, TYPE LOAD 11, TYPE RUN;;;Zofka s prikazem pro tisk: prikazy z klavesnice, potvrzeni Enter;;Programovani/ZOFKA
ZOFKA3;2;MGLD 00, JUMP 0003;;;korytnacka Zofka v strojovem kodu (verze 2.2): prikazy z klavesnice, potvrzeni Enter;;Programovani/ZOFKA
DIZZY;2;MGLD 00, SHIFT, NOBLINK;Space=Left Shift;Left:Left,Right:Right,Space jump:Space,Enter action:Return,Esc:Escape;Magicland Dizzy (PMD 85-2A/3, cb verze bez hudby): sipky = pohyb, Shift = skok/start, Enter = akce/zvednout (pad: A skok, B akce);P;
JETPAC;1;MGLD 01;;;Jetpac: v menu 3 = klavesnice, 5 = start, 7 = nastaveni klaves;;
PSSST;1;MGLD 02;;;Pssst: v menu 3 = klavesnice, 5 = start, 7 = nastaveni klaves;;
ARKANOID;1;MGLD 04;Return=Space;Left:Left,Right:Right,Space:Space,Esc:Escape;sipky vlevo/vpravo = palka, Space = start a odpal micku (pad: A, B nebo Start, TV: OK = Space), na tabulce neprepinat J (ovladac);PR;ARKANOID
ARKANOID-S;1;MGLD 04, POKE 355F 00, POKE 3560 00, POKE 3561 00, POKE 357D 00, POKE 357E 00, POKE 357F 00;Return=Space;Left:Left,Right:Right,Space:Space,Esc:Escape;sipky vlevo/vpravo = palka, Space = start a odpal micku (pad: A, B nebo Start, TV: OK = Space), na tabulce neprepinat J (ovladac) (upraveno: palka zrychluje stejne vlevo i vpravo);PR;ARKANOID
TREAISLA;1;MGLD 05;Left=O,Right=P,Up=Q,Down=A,Space=M,Return=S;Q up:q,A down:a,O left:o,P right:p,M hod mece/skok:m,S start:s,H pauza:h,T pokracovat:t,Esc:Escape;S = start, pak M (PRESS FIRE), Q/A/O/P = pohyb, M = hod mece/skok, H pauza, T pokracovat, F1 = zvuk (pad: D-pad, A = M, B = S);P;
TRAILBLA;1;MGLD 06;;;Enter = hra, I informace, B barvy, H hudba, J joystick (jen klavesnice);;
JSWILLY;1;MGLD 08;;;Jet Set Willy: v menu 3 = start, 1 = ovladani (jen klavesnice);;
FFRUITS;1;MGLD 09;;;Enter = nova hra, Keypad + (RCL) = redefinice klaves, Ctrl (STOP) = menu, 1-4 nastaveni (jen klavesnice);;
MAGICIAN;1;MGLD 0A;Left=O,Right=P,Up=Q,Down=A,Space=M;Q up:q,A down:a,O left:o,P right:p,M akce:m,1:1,2:2,3:3,4:4,Esc:Escape;v menu 1 = start, 2 obtiznost, 3 ovladani, 4 zvuk, hra: Q/A/O/P a M (pad: D-pad, A = M);P;
FLAPPY2K;1;MGLD 0B;Up=E,Down=Z;E up:e,Y down:z,Left:Left,Right:Right,Space:Space,Enter:Return,G:g,P:p,S:s,Stop:Left Ctrl,Esc:Escape;menu G = hra (vyber sceny: sipky a Space), P = heslo, S = nastaveni, ve hre sipky = pohyb, Space = ohen, Stop (Ctrl) = zpet;P;FLAPPY
KASWORD3;1;MGLD 00, JUMP 0000;;;textovy editor KASWORD 3 (nic se neuklada, jen klavesnice);;Programy
EVIDENCE;1;MGLD 00, TAPESAVE;;;EVIDENCE: adresa a datum Enter, jmeno souboru na 8 znaku (ZAJ.CIN a mezera, CLEN.ZAK, PROGRAMY, SEZNAM s mezerou na zacatku i na konci), F11 = velka pismena, ulozeni M S C, jen klavesnice;;Programy
EVIDEDIT;1;MGLD 00, TAPESAVE EVIDENCE;;;EVIDEDIT: nazvy souboru a polozek, nova data pro EVIDENCE (ulozi se na magnetofon do saves/EVIDENCE), jen klavesnice;;Programy
K-STUDIO;2;MGLD 01;;;graficky editor K-STUDIO (nic se neuklada, bez mysi);;Programy
GR;2;MGLD 00;;;graficky editor GR (nic se neuklada, bez mysi);;Programy
FLAPPY-V1;1;MGLD 03;Up=E,Down=Z;E up:e,Y down:z,Left:Left,Right:Right,Space:Space,Enter:Return,H:h,I:i,Shift:Left Shift,RCL:Keypad +,Stop:Left Ctrl,F1:F1,Esc:Escape;E/Y nahoru/dolu, Space = hod, F1 = konec, Stop (Ctrl) = reset, kody jen klavesnici;;FLAPPY
PONTRIS;1;MGLD 00;;;F1 hra, F2 info, F3 tabulka, F4 barevne, F5 zmena ovladani, F6 editace, F7 ulozit;;PONTRIS
PONTRIS2;1;MGLD 00;;;F1 hra, F2 info, F3 tabulka, F4 barevne, F5 zmena ovladani, F6 editace, F7 ulozit;;PONTRIS
SMYCKY;1;MGLD 00;;;F1 hra, F2 info, F3 tabulka, F4 cernobile, F5 zmena ovladani, F6 ulozit;;
BOULD+4;1;MGLD 03;Return=H,Space=H,Up=E,Down=Z;E up:e,Y down:z,Left:Left,Right:Right,H:h,Esc:Escape;H hra, I informace, sipky vlevo/vpravo, E/Y nahoru/dolu (pad a TV: OK = H);PR;BOULDER
MANIC23C;1;MGLD 03;Space=Left Shift,Up=@Left Shift,Down=A;Left:Left,Right:Right,Jump:Left Shift,Jump left:Left Shift&Left,Jump right:Left Shift&Right,H:h,0:0,Esc:Escape;H hra (menu cheatu: 1-5 volby, 0 spusti hru), sipky, skok: Shift nebo sipka nahoru;;MANIC
PEXESO2;2;MGLD 00;;;menu: 1 hra dvou hracu, 2 proti pocitaci, 3 klavesy, 4 ukazka, 5 konec;;Deskove hry/PEXESO
WILLY2;2;MGLD 00, JUMP 0000;;;Space = start;;WILLY
KVADRO;1;MGLD 00;;;menu: S start (K klavesnice, J joystick, R redefinice, F barvy);;KVADRO
KVADRO.E;1;MGLD 00;;;menu: S start (K klavesnice, J joystick, R redefinice, F barvy);;KVADRO
PLOTTING;1;MGLD 00;;;menu: 1 klavesnice, 2 joystick, 3 monochrom, 5 start (po vyberu 1);;
GAME2048;1;MGLD 00;;;S start, C barvy, hra sipkami (jen klavesnice);;
SOLITER;1;MGLD 00;;;sipky = kurzor (mys), Space/Enter = klik, Informace a Zacit hrat;;Deskove hry
ATOMIX;1;MGLD 00;;;menu: 1 start, 2 klavesy, 3 barvy, hra Q/A/O/P, Space = akce, EOL napoveda, R znovu, 0 konec;;
TVARE;1;MGLD 00, TAPELOOP;;;menu: 1 klavesnice, 2 joystick, 3 barvy, pak 0 = start;;
LEMMINGS;1;MGLD 00, TAPELOOP;;;menu: S start, N nastaveni, I informace, H heslo, hra: kurzor sipkami, F1-F12 (K0-K11) = volba cinnosti, Space, dalsi sektory se nahravaji z pasky;;
