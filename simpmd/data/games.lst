BLUDISTE;2;MGLD 00;Up=Left Shift,E=Left Shift,H=M,I=Left Ctrl;Forward:Left Shift,Left:Left,Right:Right,Space:Space,M:m,Stop:Left Ctrl,Esc:Escape;krok: Shift (pad: nahoru), obrat: sipky, M mapa (pad: X), Ctrl = STOP, konec hry (pad: Y), Space start;P
BOMBARDE;2;ROM basic2.rmm, FONT, TYPE LOAD 2, TYPE RUN;Space=F1,Left Shift=F6;Bomb:F1,Fire:F6,Esc:Escape;F1 (K0) bomba, F6 (K5) strelba, libovolna klavesa start (pad: A bomba, LB strelba);P;BASIC
