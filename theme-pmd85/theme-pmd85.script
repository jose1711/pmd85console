# A random scene at the start of the boot, the next one every SCENE_SECONDS, a progress bar of blocks, a blinking cursor.
SCENES = 24;          # patched by make-splash.py from scenes.count
SCENE_SECONDS = 30;
BLOCKS = 20;

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# The box of the picture, the scenes are scaled down only (small screens), centred in it.
box_w = Window.GetWidth() * 0.9;
box_h = Window.GetHeight() * 0.8;
box_y = Window.GetHeight() * 0.06;

splash_sprite = Sprite();

fun show_scene (n) {
    scene_image = Image("scene-" + n + ".png");
    fit = box_h / scene_image.GetHeight();
    fit_w = box_w / scene_image.GetWidth();
    if (fit_w < fit) fit = fit_w;
    if (fit > 1) fit = 1;
    if (fit < 1) scene_image = scene_image.Scale(scene_image.GetWidth() * fit, scene_image.GetHeight() * fit);
    splash_sprite.SetImage(scene_image);
    splash_sprite.SetX(Window.GetWidth() / 2 - scene_image.GetWidth() / 2);
    splash_sprite.SetY(box_y + (box_h - scene_image.GetHeight()) / 2);
}

scene = Math.Int(Math.Random() * SCENES) + 1;
if (scene > SCENES) scene = SCENES;
show_scene(scene);

# The bar stays under the box, whatever the height of the picture.
block_image = Image("block.png");
bw = block_image.GetWidth();
bh = block_image.GetHeight();
step = bw + 6;
bar_x = Window.GetWidth() / 2 - (BLOCKS * step - 6) / 2;
bar_y = box_y + box_h + Window.GetHeight() * 0.04;
if (bar_y + bh > Window.GetHeight() - 4) bar_y = Window.GetHeight() - bh - 4;

for (i = 0; i < BLOCKS; i++) {
    block[i] = Sprite(block_image);
    block[i].SetX(bar_x + i * step);
    block[i].SetY(bar_y);
    block[i].SetOpacity(0.15);
}

progress = 0;
tick = 0;
boot_time = 0;      # seconds since the start of the boot, from the boot progress callback
shown_slot = 0;     # the number of the SCENE_SECONDS period the picture belongs to

fun refresh_callback () {
    tick++;
    filled = Math.Int(progress * BLOCKS);
    for (i = 0; i < BLOCKS; i++) {
        if (i < filled) block[i].SetOpacity(1);
        else if (i == filled && Math.Int(tick / 15) % 2 == 0) block[i].SetOpacity(1);   # blinking cursor
        else block[i].SetOpacity(0.15);
    }
    # The refresh runs about 50 times a second; the boot time of the progress callback wins when it is further.
    elapsed = tick / 50;
    if (boot_time > elapsed) elapsed = boot_time;
    slot = Math.Int(elapsed / SCENE_SECONDS);
    if (slot != shown_slot) {
        shown_slot = slot;
        scene++;
        if (scene > SCENES) scene = 1;
        show_scene(scene);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun boot_progress_callback (time, prog) {
    progress = prog;
    boot_time = time;
}
Plymouth.SetBootProgressFunction(boot_progress_callback);
